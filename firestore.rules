rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user owns the document
    function isOwner() {
      return request.auth != null && resource.data.addedBy == request.auth.uid;
    }

    // Helper function to check if the new document assigns the correct owner
    function isCreatingWithOwner() {
      return request.auth != null && request.resource.data.addedBy == request.auth.uid;
    }

    match /projects/{document} {
      allow read: if true;
      allow create: if isCreatingWithOwner();
      allow update, delete: if isOwner();
    }
    
    match /events/{document} {
      allow read: if true;
      allow create: if isCreatingWithOwner();
      allow update, delete: if isOwner();
    }
    
    match /clubs/{document} {
      allow read: if true;
      allow create: if isCreatingWithOwner();
      allow update, delete: if isOwner();
    }
    
    match /notices/{document} {
      allow read: if true;
      allow create: if isCreatingWithOwner();
      allow update, delete: if isOwner();
    }
    
    match /archives/{document} {
      allow read: if true;
      allow create: if isCreatingWithOwner();
      allow update, delete: if isOwner();
    }
    
    match /gallery/{document} {
      allow read: if true;
      allow create: if isCreatingWithOwner();
      allow update, delete: if isOwner();
    }
    
    match /calendar/{document} {
      allow read: if true;
      allow create: if isCreatingWithOwner();
      allow update, delete: if isOwner();
    }
    
    match /profiles/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
